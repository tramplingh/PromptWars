{
  "name": "lablink",
  "version": "1.0.0",
  "private": true,
  "description": "LabLink — GenAI-powered campus laboratory resource-sharing platform",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm run dev -w @lablink/server\" \"npm run dev -w @lablink/web\"",
    "build": "npm run build -w @lablink/web && npm run build -w @lablink/server",
    "start": "npm run start -w @lablink/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.10.1",
    "typescript": "~5.7",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
