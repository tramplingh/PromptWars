# Copy to .env and fill in. Never commit real secrets.

# Server port (Cloud Run injects PORT automatically)
PORT=8080

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# Optional: without it, LabLink uses deterministic rule-based fallbacks.
GEMINI_API_KEY=
# gemini-3.1-flash-lite: fast, with the most generous free-tier quota (15 RPM / 500 RPD).
GEMINI_MODEL=gemini-3.1-flash-lite
# Tried in order if the primary model is overloaded, out of quota or times out.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite

# Secret used to sign session cookies. REQUIRED in production (min 32 chars).
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# Storage backend: "memory" (default, seeded demo data) or "firestore".
DATA_BACKEND=memory
# Required when DATA_BACKEND=firestore (uses Application Default Credentials).
GOOGLE_CLOUD_PROJECT=

# Optional demo setting: shift the campus clock, e.g. -9 to show lab hours in the evening. Keep both equal.
CLOCK_OFFSET_HOURS=0
VITE_CLOCK_OFFSET_HOURS=0
